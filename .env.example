NODE_ENV=development

PORT=3000
JSON_BODY_LIMIT=5mb

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wpp_campaigns

WORKER_BATCH_SIZE=50
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=1000
MAX_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
PROVIDER_TIMEOUT_MS=10000
SENDING_TIMEOUT_MS=60000

FAKE_FAIL_RATE=0.2
